# Ala: every key is free and none needs a card. Copy this file to .env.local and fill in what you have.
# Nothing here is required for the tests. See README.md for where each key comes from.

# --- LiveKit (leave empty to use the local server from docker compose) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Thinking (free tiers). One account per service: limits follow the account, not the key ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Listening and voice ---
SARVAM_API_KEY=
GLADIA_API_KEY=

# --- Data (leave empty for a local SQLite file) ---
DATABASE_URL=

# --- The public demo ---
# Callers must present this code (it travels in the shared link). Empty means no code is needed.
ALA_INVITE_CODE=
